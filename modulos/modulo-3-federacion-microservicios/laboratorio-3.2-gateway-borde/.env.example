# Copia este archivo a .env antes de levantar el stack.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# Valor de arranque: hace falta ALGO no vacío para que oauth2-proxy levante la primera
# vez (el cliente "gateway" todavía no existe en Keycloak en ese momento). Se sustituye
# por el secreto real en el Guiado, paso 2, y se reinicia oauth2-proxy para recogerlo.
OAUTH2_PROXY_CLIENT_SECRET=placeholder-temporal

# Generar con: openssl rand -base64 32 | tr '+/' '-_'
# (tiene que ser base64 "URL-safe": oauth2-proxy no decodifica un '+' u '/' y en ese
# caso cuenta el string tal cual, más largo de 32 bytes, y rechaza el arranque)
OAUTH2_PROXY_COOKIE_SECRET=
